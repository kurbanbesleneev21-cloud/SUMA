<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>НомерОценка — Цифровой Алмаз</title>

    <style>
        @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap");

        :root {
            --bg: #050507;
            --glass: rgba(16, 17, 27, .68);
            --glass-light: rgba(255, 255, 255, .07);
            --line: rgba(255, 255, 255, .14);
            --text: #f5f7ff;
            --muted: #868a9d;
            --cyan: #00f0ff;
            --purple: #9d00ff;
            --pink: #ff24d8;
            --green: #00e676;
            --yellow: #ffe27a;
            --danger: #ffd66b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            color: var(--text);
            background: var(--bg);
            font-family: Inter, Arial, sans-serif;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        #spaceCanvas {
            position: fixed;
            inset: 0;
            z-index: -4;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .grid-floor {
            position: fixed;
            z-index: -3;
            right: -20%;
            bottom: -25%;
            left: -20%;
            height: 75%;
            opacity: .32;
            transform: perspective(500px) rotateX(64deg);
            transform-origin: bottom;
            background-image:
                linear-gradient(
                    rgba(0, 240, 255, .18) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(157, 0, 255, .18) 1px,
                    transparent 1px
                );
            background-size: 55px 55px;
            mask-image: linear-gradient(
                to top,
                black,
                transparent 85%
            );
            animation: gridMove 14s linear infinite;
            pointer-events: none;
        }

        .ambient {
            position: fixed;
            z-index: -2;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            filter: blur(110px);
            opacity: .16;
            pointer-events: none;
        }

        .ambient.one {
            top: -180px;
            left: -130px;
            background: var(--purple);
        }

        .ambient.two {
            right: -160px;
            bottom: -160px;
            background: var(--cyan);
        }

        .cursor-glow {
            position: fixed;
            z-index: 20;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            opacity: .12;
            background: radial-gradient(
                circle,
                var(--cyan),
                transparent 68%
            );
            pointer-events: none;
            transform: translate(-50%, -50%);
            transition: opacity .3s;
        }

        .page {
            width: min(1080px, calc(100% - 32px));
            margin: 0 auto;
            padding: 28px 0 70px;
        }

        .glass {
            position: relative;
            border: 1px solid transparent;
            border-radius: 24px;
            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,.10),
                    rgba(255,255,255,.025)
                ) padding-box,
                linear-gradient(
                    135deg,
                    rgba(0,240,255,.5),
                    rgba(157,0,255,.25),
                    rgba(255,36,216,.35)
                ) border-box;
            box-shadow:
                0 25px 80px rgba(0, 0, 0, .42),
                inset 0 1px rgba(255, 255, 255, .1);
            backdrop-filter: blur(22px);
        }

        .reveal {
            opacity: 0;
            transform: translateY(55px) translateZ(-100px);
            transition:
                opacity .8s ease,
                transform .8s cubic-bezier(.2,.8,.2,1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0) translateZ(0);
        }

        header {
            padding: 15px 0 35px;
            text-align: center;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--cyan);
            font-family: "Space Grotesk", sans-serif;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cyan);
            box-shadow: 0 0 18px var(--cyan);
            animation: pulse 1.6s ease-in-out infinite;
        }

        h1 {
            margin-top: 17px;
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(3rem, 9vw, 7.2rem);
            font-weight: 700;
            line-height: .9;
            letter-spacing: -6px;
            background: linear-gradient(
                110deg,
                white 15%,
                var(--cyan) 46%,
                #fff 68%,
                var(--purple)
            );
            background-size: 240% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textShine 6s linear infinite;
        }

        .hero-subtitle {
            max-width: 590px;
            margin: 24px auto 0;
            color: var(--muted);
            font-size: clamp(1rem, 2vw, 1.2rem);
            line-height: 1.6;
        }

        .hero-orb {
            position: relative;
            display: grid;
            place-items: center;
            width: 180px;
            height: 180px;
            margin: 30px auto 10px;
            perspective: 700px;
        }

        .orb-ring {
            position: absolute;
            inset: 10px;
            border: 1px solid rgba(0, 240, 255, .4);
            border-radius: 50%;
            box-shadow:
                0 0 28px rgba(0, 240, 255, .25),
                inset 0 0 25px rgba(157, 0, 255, .18);
            animation: ringSpin 8s linear infinite;
        }

        .orb-ring::after {
            position: absolute;
            inset: 18px -8px;
            border: 1px solid rgba(157, 0, 255, .55);
            border-radius: 50%;
            content: "";
            transform: rotate(62deg);
        }

        .orb-icon {
            position: relative;
            z-index: 2;
            color: white;
            font-family: "Space Grotesk", sans-serif;
            font-size: 6.5rem;
            font-weight: 700;
            line-height: 1;
            text-shadow:
                0 0 6px #fff,
                0 0 18px var(--cyan),
                0 0 42px var(--purple);
            animation: floatIcon 4s ease-in-out infinite,
                iconSpin 10s ease-in-out infinite;
            transform-style: preserve-3d;
        }

        .orb-label {
            position: absolute;
            bottom: -3px;
            color: var(--cyan);
            font-size: .62rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .search-card {
            padding: clamp(20px, 4vw, 38px);
        }

        .section-kicker {
            margin-bottom: 16px;
            color: var(--cyan);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .input-row {
            display: flex;
            gap: 12px;
        }

        .phone-input {
            flex: 1;
            min-width: 0;
            padding: 18px 20px;
            outline: none;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 15px;
            color: var(--text);
            background: rgba(0,0,0,.3);
            box-shadow: inset 0 0 25px rgba(0,240,255,.025);
            font-size: 1.3rem;
            letter-spacing: 2px;
            transition: .3s;
        }

        .phone-input:focus {
            border-color: var(--cyan);
            box-shadow:
                0 0 0 4px rgba(0,240,255,.1),
                0 0 35px rgba(0,240,255,.16),
                inset 0 0 30px rgba(0,240,255,.05);
        }

        .phone-input::placeholder {
            color: #626678;
            font-size: 1rem;
            letter-spacing: 0;
        }

        .neon-button {
            position: relative;
            overflow: hidden;
            border: 0;
            border-radius: 15px;
            color: white;
            font-weight: 800;
            transition: .25s;
        }

        .neon-button::before {
            position: absolute;
            top: 0;
            left: -110%;
            width: 80%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,.65),
                transparent
            );
            content: "";
            transform: skewX(-20deg);
            transition: .55s;
        }

        .neon-button:hover::before {
            left: 140%;
        }

        .evaluate-button {
            padding: 0 28px;
            background: linear-gradient(
                135deg,
                var(--cyan),
                #007cf0
            );
            box-shadow: 0 0 25px rgba(0,240,255,.22);
        }

        .evaluate-button:hover {
            transform: translateY(-3px);
            box-shadow:
                0 0 12px var(--cyan),
                0 12px 30px rgba(0,240,255,.2);
        }

        .microcopy {
            margin-top: 12px;
            color: var(--muted);
            font-size: .8rem;
            line-height: 1.5;
        }

        .validation {
            display: none;
            margin-top: 14px;
            padding: 10px 13px;
            border: 1px solid rgba(255,226,122,.5);
            border-radius: 12px;
            color: var(--danger);
            background: rgba(255,226,122,.07);
            animation: warningPulse 1.3s ease-in-out infinite;
        }

        .validation.show {
            display: block;
        }

        .loading {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            color: var(--cyan);
            font-size: .8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .loading.show {
            display: flex;
        }

        .loading-diamond {
            width: 16px;
            height: 16px;
            border: 2px solid var(--cyan);
            box-shadow: 0 0 15px var(--cyan);
            animation: loadingDiamond .8s linear infinite;
            transform: rotate(45deg);
        }

        .result-card {
            margin-top: 25px;
            padding: clamp(22px, 4vw, 42px);
            transform-style: preserve-3d;
            transition: transform .18s ease-out;
        }

        .result-card::before {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background:
                radial-gradient(
                    circle at var(--mx, 50%) var(--my, 20%),
                    rgba(0,240,255,.16),
                    transparent 30%
                );
            content: "";
            pointer-events: none;
        }

        .result-card.reveal-card {
            animation: cardOpen .8s cubic-bezier(.2,.8,.2,1);
        }

        .result-number {
            position: relative;
            z-index: 1;
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(1.6rem, 5vw, 2.6rem);
            font-weight: 700;
            letter-spacing: 3px;
        }

        .category-name {
            position: relative;
            z-index: 1;
            margin-top: 10px;
            color: var(--cyan);
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .price-title {
            margin-top: 27px;
            color: var(--muted);
            font-size: .78rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .price {
            margin-top: 6px;
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(2.4rem, 8vw, 4.6rem);
            font-weight: 700;
            background: linear-gradient(
                110deg,
                var(--yellow),
                white,
                var(--cyan)
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .range {
            color: var(--muted);
            font-size: .9rem;
        }

        .data-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 28px;
        }

        .data-item {
            min-height: 100px;
            padding: 17px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            background: rgba(0,0,0,.2);
        }

        .data-label {
            color: var(--muted);
            font-size: .68rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .data-value {
            margin-top: 10px;
            color: white;
            font-family: "Space Grotesk", sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
        }

        .score-ring {
            position: relative;
            display: grid;
            place-items: center;
            width: 62px;
            height: 62px;
            margin: 8px auto 0;
            border-radius: 50%;
            background: conic-gradient(
                var(--cyan) 0deg,
                var(--purple) 0deg,
                rgba(255,255,255,.08) 0deg
            );
        }

        .score-ring::after {
            position: absolute;
            inset: 5px;
            border-radius: 50%;
            background: #11121b;
            content: "";
        }

        .score-ring span {
            position: relative;
            z-index: 1;
            font-size: .95rem;
            font-weight: 800;
        }

        .chips-title {
            margin-top: 28px;
            color: var(--muted);
            font-size: .75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 11px;
        }

        .chip {
            padding: 8px 12px;
            border: 1px solid rgba(0,240,255,.25);
            border-radius: 30px;
            color: var(--cyan);
            background: rgba(0,240,255,.06);
            font-size: .75rem;
        }

        .actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 28px;
        }

        .action-button {
            padding: 16px;
            border: 0;
            border-radius: 14px;
            color: white;
            font-weight: 800;
            transition: .25s;
        }

        .action-button:hover {
            transform: translateY(-3px);
        }

        .buy-button {
            background: linear-gradient(
                135deg,
                #00d66b,
                #087f5b
            );
            box-shadow: 0 0 25px rgba(0,230,118,.2);
        }

        .sell-button {
            background: linear-gradient(
                135deg,
                var(--purple),
                #5000bd
            );
            box-shadow: 0 0 25px rgba(157,0,255,.2);
        }

        .whatsapp-note {
            margin-top: 11px;
            color: var(--muted);
            text-align: center;
            font-size: .76rem;
        }

        .explanation {
            margin-top: 27px;
        }

        .explanation-title {
            color: white;
            font-size: .85rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .explanation-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 13px;
            list-style: none;
        }

        .explanation-list li {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            padding: 11px 13px;
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 12px;
            color: var(--muted);
            background: rgba(255,255,255,.035);
            font-size: .8rem;
        }

        .explanation-list li span:first-child {
            flex: 1;
        }

        .explanation-list li span:last-child {
            color: var(--yellow);
            white-space: nowrap;
            font-weight: 700;
        }

        .history {
            margin-top: 34px;
        }

        .history-title {
            margin-bottom: 14px;
            color: var(--muted);
            font-size: .75rem;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .history-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 14px 17px;
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 15px;
            background: rgba(255,255,255,.035);
            cursor: pointer;
            transition: .2s;
        }

        .history-item:hover {
            border-color: var(--cyan);
            background: rgba(0,240,255,.07);
        }

        .history-number {
            font-family: "Space Grotesk", sans-serif;
            font-weight: 700;
        }

        .history-meta {
            color: var(--muted);
            text-align: right;
            font-size: .76rem;
        }

        .history-price {
            display: block;
            margin-top: 3px;
            color: var(--yellow);
            font-weight: 700;
        }

        footer {
            margin-top: 45px;
            color: #646879;
            text-align: center;
            font-size: .75rem;
            line-height: 1.7;
        }

        @keyframes gridMove {
            from {
                background-position: 0 0;
            }

            to {
                background-position: 0 550px;
            }
        }

        @keyframes pulse {
            50% {
                opacity: .35;
                transform: scale(.65);
            }
        }

        @keyframes textShine {
            to {
                background-position: 240% center;
            }
        }

        @keyframes ringSpin {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes floatIcon {
            0%, 100% {
                transform: translateY(0) rotateY(0deg);
            }

            50% {
                transform: translateY(-13px) rotateY(180deg);
            }
        }

        @keyframes iconSpin {
            0%, 100% {
                filter: brightness(1);
            }

            50% {
                filter: brightness(1.35);
            }
        }

        @keyframes warningPulse {
            50% {
                box-shadow: 0 0 22px rgba(255,226,122,.18);
            }
        }

        @keyframes loadingDiamond {
            to {
                transform: rotate(405deg) scale(.65);
            }
        }

        @keyframes cardOpen {
            0% {
                opacity: 0;
                transform: perspective(900px)
                    rotateX(15deg)
                    scale(.82)
                    translateZ(-120px);
            }

            100% {
                opacity: 1;
                transform: perspective(900px)
                    rotateX(0)
                    scale(1)
                    translateZ(0);
            }
        }

        @media (max-width: 680px) {
            .page {
                width: calc(100% - 20px);
            }

            h1 {
                letter-spacing: -3px;
            }

            .hero-orb {
                transform: scale(.82);
                margin-top: 20px;
            }

            .input-row {
                flex-direction: column;
            }

            .evaluate-button {
                min-height: 55px;
            }

            .data-grid {
                grid-template-columns: 1fr 1fr;
            }

            .actions {
                grid-template-columns: 1fr;
            }

            .history-item {
                align-items: flex-start;
                flex-direction: column;
            }

            .history-meta {
                text-align: left;
            }
        }

        @media (max-width: 430px) {
            .data-grid {
                grid-template-columns: 1fr;
            }

            .result-number {
                font-size: 1.35rem;
            }

            .price {
                font-size: 2.5rem;
            }
        }
    </style>
</head>

<body>
    <canvas id="spaceCanvas"></canvas>
    <div class="grid-floor"></div>
    <div class="ambient one"></div>
    <div class="ambient two"></div>
    <div id="cursorGlow" class="cursor-glow"></div>

    <main class="page">
        <header class="reveal">
            <div class="brand">
                <span class="brand-dot"></span>
                Digital number intelligence
            </div>

            <h1>НомерОценка</h1>

            <p class="hero-subtitle">
                Интеллектуальная оценка рыночной стоимости
                красивых телефонных номеров.
            </p>

            <div id="heroOrb" class="hero-orb">
                <div class="orb-ring"></div>
                <div class="orb-icon">#</div>
                <div class="orb-label">digital diamond</div>
            </div>
        </header>

        <section class="glass search-card reveal">
            <div class="section-kicker">
                // market scanner
            </div>

            <div class="input-row">
                <input
                    id="phoneInput"
                    class="phone-input"
                    type="tel"
                    maxlength="20"
                    autocomplete="off"
                    placeholder="+7 999 123-45-67"
                >

                <button
                    id="evaluateButton"
                    class="neon-button evaluate-button"
                    type="button"
                    onclick="evaluateNumber()"
                >
                    Оценить номер
                </button>
            </div>

            <p class="microcopy">
                Анализируем последние 10 цифр. Поддерживаем любой формат ввода.
            </p>

            <div id="validation" class="validation">
                ⚠ Пожалуйста, введите минимум 10 цифр
            </div>

            <div id="loading" class="loading">
                <span class="loading-diamond"></span>
                Сканируем цифровую структуру
            </div>
        </section>

        <section id="result" class="result">
            <div id="resultCard" class="glass result-card">
                <div id="resultNumber" class="result-number"></div>

                <div id="resultCategory" class="category-name">
                    —
                </div>

                <div class="price-title">
                    Рыночный диапазон стоимости
                </div>

                <div id="resultPrice" class="price">
                    0 ₽
                </div>

                <div id="resultRange" class="range">
                    —
                </div>

                <div class="data-grid">
                    <div class="data-item">
                        <div class="data-label">Категория</div>
                        <div id="categoryValue" class="data-value">
                            —
                        </div>
                    </div>

                    <div class="data-item">
                        <div class="data-label">Индекс редкости</div>

                        <div
                            id="scoreRing"
                            class="score-ring"
                        >
                            <span id="scoreValue">0</span>
                        </div>
                    </div>

                    <div class="data-item">
                        <div class="data-label">Уникальных цифр</div>
                        <div id="uniqueValue" class="data-value">
                            0
                        </div>
                    </div>

                    <div class="data-item">
                        <div class="data-label">Код номера</div>
                        <div id="codeValue" class="data-value">
                            —
                        </div>
                    </div>
                </div>

                <div class="chips-title">
                    // особенности комбинации
                </div>

                <div id="patterns" class="chips"></div>

                <div class="actions">
                    <button
                        class="action-button buy-button"
                        type="button"
                        onclick="buyNumber()"
                    >
                        🟢 Купить красивый номер
                    </button>

                    <button
                        class="action-button sell-button"
                        type="button"
                        onclick="sellNumber()"
                    >
                        💜 Продать свой номер
                    </button>
                </div>

                <div class="whatsapp-note">
                    Откроется WhatsApp с готовым сообщением
                </div>

                <div class="explanation">
                    <div class="explanation-title">
                        💡 Из чего складывается стоимость
                    </div>

                    <ul
                        id="explanationList"
                        class="explanation-list"
                    ></ul>
                </div>
            </div>
        </section>

        <section
            id="historyBlock"
            class="history reveal"
            style="display: none"
        >
            <div class="history-title">
                🕓 История оценок
            </div>

            <div id="historyList" class="history-list"></div>
        </section>

        <footer class="reveal">
            Стоимость является алгоритмической рыночной оценкой.
            Фактическая цена зависит от региона, продавца, спроса
            и условий переоформления.
        </footer>
    </main>

    <script>
        const WHATSAPP_NUMBER = "79999993834";

        const phoneInput =
            document.getElementById("phoneInput");

        const validation =
            document.getElementById("validation");

        const loading =
            document.getElementById("loading");

        const result =
            document.getElementById("result");

        const resultCard =
            document.getElementById("resultCard");

        let currentNumber = "";
        let currentResult = null;
        let history = loadHistory();

        initReveal();
        initCursor();
        initTilt();
        initParticles();
        renderHistory();

        phoneInput.addEventListener("input", function () {
            let value = phoneInput.value.replace(/[^\d+]/g, "");

            if (value.includes("+")) {
                value =
                    "+" +
                    value
                        .replace(/\+/g, "")
                        .replace(/\D/g, "");
            }

            phoneInput.value = value;
            validation.classList.remove("show");
        });

        phoneInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                evaluateNumber();
            }
        });

        function evaluateNumber() {
            const raw = phoneInput.value.replace(/\D/g, "");
            const digits = raw.slice(-10);

            if (digits.length < 10) {
                validation.classList.add("show");
                result.classList.remove("show");
                phoneInput.focus();
                return;
            }

            validation.classList.remove("show");
            loading.classList.add("show");

            setTimeout(function () {
                currentNumber = digits;
                currentResult = analyzeNumber(digits);

                loading.classList.remove("show");
                showResult(digits, currentResult);
                addToHistory(digits, currentResult);
            }, 650);
        }

        function analyzeNumber(digits) {
            const code = digits.slice(0, 3);
            const tail = digits.slice(3);
            const basePrice = 300;

            const patterns = [];
            const breakdown = [];

            let category = "Масс-маркет";
            let badgeClass = "standard";
            let minPrice = 100;
            let maxPrice = 500;
            let estimatedPrice = 300;

            const maxRepeat = getMaxRepeat(tail);
            const allTailSame =
                tail.length > 0 &&
                new Set(tail).size === 1;

            const isPalindrome =
                tail === reverseString(tail);

            const sequenceLength =
                getSequenceLength(tail);

            const pairCount =
                (tail.match(/(\d)\1/g) || []).length;

            const premiumCodes = [
                "495", "499", "916", "925", "926",
                "985", "999", "903", "905", "909"
            ];

            const isPremiumCode =
                premiumCodes.includes(code);

            if (
                allTailSame ||
                new Set(digits).size === 1
            ) {
                category = "Бриллиантовый VIP";
                badgeClass = "diamond";
                minPrice = 200000;
                maxPrice = 5000000;
                estimatedPrice = 500000;

                patterns.push("💎 VIP-комбинация");
                patterns.push("🏆 Семь одинаковых цифр");
            } else if (
                maxRepeat >= 5 ||
                (isPalindrome && tail.length >= 7)
            ) {
                category = "Платиновый";
                badgeClass = "platinum";
                minPrice = 50000;
                maxPrice = 150000;
                estimatedPrice = 100000;

                if (maxRepeat >= 5) {
                    patterns.push(
                        "🔥 " + maxRepeat +
                        " одинаковых цифр подряд"
                    );
                }

                if (isPalindrome) {
                    patterns.push("🪞 Идеальная зеркальная структура");
                }
            } else if (
                maxRepeat >= 4 ||
                pairCount >= 3 ||
                sequenceLength >= 5
            ) {
                category = "Золотой";
                badgeClass = "gold";
                minPrice = 12000;
                maxPrice = 50000;
                estimatedPrice = 30000;

                if (maxRepeat >= 4) {
                    patterns.push(
                        "✨ " + maxRepeat +
                        " одинаковых цифры подряд"
                    );
                }

                if (pairCount >= 3) {
                    patterns.push("🎯 Красивые парные комбинации");
                }

                if (sequenceLength >= 5) {
                    patterns.push(
                        "📈 Последовательность из " +
                        sequenceLength + " цифр"
                    );
                }
            } else if (
                maxRepeat >= 3 ||
                isPalindrome ||
                pairCount >= 2 ||
                sequenceLength === 4
            ) {
                category = "Серебряный";
                badgeClass = "silver";
                minPrice = 3000;
                maxPrice = 10000;
                estimatedPrice = 6500;

                if (maxRepeat >= 3) {
                    patterns.push(
                        "🔹 " + maxRepeat +
                        " одинаковые цифры подряд"
                    );
                }

                if (isPalindrome) {
                    patterns.push("🪞 Зеркальная комбинация");
                }

                if (pairCount >= 2) {
                    patterns.push("👯 Две красивые пары");
                }

                if (sequenceLength === 4) {
                    patterns.push(
                        "↗️ Последовательность из 4 цифр"
                    );
                }
            } else if (pairCount >= 1) {
                category = "Бронзовый";
                badgeClass = "bronze";
                minPrice = 1000;
                maxPrice = 3000;
                estimatedPrice = 2000;

                patterns.push("👯 Простая запоминающаяся пара");

                if (pairCount >= 2) {
                    patterns.push("✨ Несколько повторяющихся пар");
                }
            } else {
                patterns.push("Обычная цифровая комбинация");
            }

            let multiplier = 1;

            if (isPremiumCode) {
                multiplier = 2;
                patterns.push("📍 Ценный код " + code);
            }

            if (category !== "Бриллиантовый VIP") {
                minPrice = Math.round(minPrice * multiplier);
                maxPrice = Math.round(maxPrice * multiplier);
                estimatedPrice = Math.round(
                    estimatedPrice * multiplier
                );
            }

            breakdown.push({
                text: "Базовая стоимость SIM-карты",
                cost: basePrice
            });

            breakdown.push({
                text: "Категория «" + category + "»",
                cost: Math.max(0, estimatedPrice - basePrice)
            });

            if (isPremiumCode) {
                breakdown.push({
                    text: "Повышающий коэффициент за код " + code,
                    cost: 0
                });
            }

            breakdown.push({
                text:
                    "Рыночный диапазон: " +
                    formatMoney(minPrice) +
                    " – " +
                    formatMoney(maxPrice),
                cost: 0
            });

            let score = 0;

            if (category === "Бриллиантовый VIP") {
                score = 100;
            } else if (category === "Платиновый") {
                score = 85;
            } else if (category === "Золотой") {
                score = 70;
            } else if (category === "Серебряный") {
                score = 50;
            } else if (category === "Бронзовый") {
                score = 25;
            } else {
                score = 5;
            }

            if (isPremiumCode) {
                score = Math.min(100, score + 10);
            }

            return {
                code,
                category,
                badgeClass,
                score,
                unique: new Set(digits).size,
                minPrice,
                maxPrice,
                estimatedPrice,
                price: estimatedPrice,
                patterns: [...new Set(patterns)],
                breakdown
            };
        }

        function showResult(digits, data) {
            document.getElementById("resultNumber").textContent =
                formatPhone(digits);

            document.getElementById("resultCategory").textContent =
                data.category;

            document.getElementById("categoryValue").textContent =
                data.category;

            document.getElementById("resultPrice").textContent =
                formatMoney(data.estimatedPrice);

            document.getElementById("resultRange").textContent =
                formatMoney(data.minPrice) +
                " — " +
                formatMoney(data.maxPrice);

            document.getElementById("uniqueValue").textContent =
                data.unique;

            document.getElementById("codeValue").textContent =
                data.code;

            animateScore(data.score);

            const patterns =
                document.getElementById("patterns");

            patterns.innerHTML = data.patterns
                .map(function (item) {
                    return `
                        <span class="chip">
                            ${escapeHtml(item)}
                        </span>
                    `;
                })
                .join("");

            const list =
                document.getElementById("explanationList");

            list.innerHTML = data.breakdown
                .map(function (item) {
                    return `
                        <li>
                            <span>
                                ${escapeHtml(item.text)}
                            </span>
                            <span>
                                ${
                                    item.cost > 0
                                        ? "+" + formatMoney(item.cost)
                                        : "—"
                                }
                            </span>
                        </li>
                    `;
                })
                .join("");

            result.classList.add("show");
            resultCard.classList.remove("reveal-card");

            void resultCard.offsetWidth;

            resultCard.classList.add("reveal-card");

            result.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        }

        function animateScore(target) {
            const scoreElement =
                document.getElementById("scoreValue");

            const ring =
                document.getElementById("scoreRing");

            let current = 0;
            const duration = 850;
            const start = performance.now();

            function frame(now) {
                const progress = Math.min(
                    1,
                    (now - start) / duration
                );

                current = Math.round(
                    target * (1 - Math.pow(1 - progress, 3))
                );

                scoreElement.textContent = current;

                const degrees =
                    current * 3.6;

                ring.style.background = `
                    conic-gradient(
                        var(--cyan) 0deg,
                        var(--purple) ${degrees * .7}deg,
                        var(--cyan) ${degrees}deg,
                        rgba(255,255,255,.08) ${degrees}deg
                    )
                `;

                if (progress < 1) {
                    requestAnimationFrame(frame);
                }
            }

            requestAnimationFrame(frame);
        }

        function buyNumber() {
            if (!currentNumber || !currentResult) {
                alert("Сначала оцените номер");
                return;
            }

            const message =
                "Здравствуйте! Хочу купить красивый номер " +
                formatPhone(currentNumber) +
                ". Расчётная стоимость: " +
                formatMoney(currentResult.estimatedPrice) +
                ". Рыночный диапазон: " +
                formatMoney(currentResult.minPrice) +
                " — " +
                formatMoney(currentResult.maxPrice) +
                ".";

            openWhatsApp(message);
        }

        function sellNumber() {
            const raw =
                phoneInput.value.replace(/\D/g, "");

            if (raw.length < 10) {
                alert("Введите номер, который хотите продать");
                phoneInput.focus();
                return;
            }

            const digits = raw.slice(-10);
            const data = analyzeNumber(digits);

            const message =
                "Здравствуйте! Хочу продать свой номер " +
                formatPhone(digits) +
                ". Расчётная стоимость: " +
                formatMoney(data.estimatedPrice) +
                ". Рыночный диапазон: " +
                formatMoney(data.minPrice) +
                " — " +
                formatMoney(data.maxPrice) +
                ".";

            openWhatsApp(message);
        }

        function openWhatsApp(message) {
            const url =
                "https://wa.me/" +
                WHATSAPP_NUMBER +
                "?text=" +
                encodeURIComponent(message);

            window.location.href = url;
        }

        function addToHistory(digits, data) {
            history.unshift({
                digits,
                price: data.estimatedPrice,
                minPrice: data.minPrice,
                maxPrice: data.maxPrice,
                category: data.category,
                time: Date.now()
            });

            history = history.filter(function (
                item,
                index,
                array
            ) {
                return index === array.findIndex(function (old) {
                    return old.digits === item.digits;
                });
            });

            history = history.slice(0, 10);
            saveHistory();
            renderHistory();
        }

        function renderHistory() {
            const block =
                document.getElementById("historyBlock");

            const list =
                document.getElementById("historyList");

            if (!history.length) {
                block.style.display = "none";
                return;
            }

            block.style.display = "block";

            list.innerHTML = history
                .map(function (item, index) {
                    return `
                        <div
                            class="history-item"
                            onclick="repeatEvaluation(${index})"
                        >
                            <span class="history-number">
                                ${formatPhone(item.digits)}
                            </span>

                            <span class="history-meta">
                                ${escapeHtml(item.category)}
                                <span class="history-price">
                                    ${formatMoney(item.price)}
                                </span>
                            </span>
                        </div>
                    `;
                })
                .join("");
        }

        function repeatEvaluation(index) {
            const item = history[index];

            if (!item) {
                return;
            }

            phoneInput.value = "+7" + item.digits;
            evaluateNumber();

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }

        function initReveal() {
            const elements =
                document.querySelectorAll(".reveal");

            const observer =
                new IntersectionObserver(function (
                    entries
                ) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    threshold: .12
                });

            elements.forEach(function (element) {
                observer.observe(element);
            });
        }

        function initCursor() {
            const glow =
                document.getElementById("cursorGlow");

            window.addEventListener("mousemove", function (event) {
                glow.style.left = event.clientX + "px";
                glow.style.top = event.clientY + "px";
            });

            window.addEventListener("mouseleave", function () {
                glow.style.opacity = "0";
            });

            window.addEventListener("mouseenter", function () {
                glow.style.opacity = ".12";
            });
        }

        function initTilt() {
            resultCard.addEventListener("mousemove", function (event) {
                const rect =
                    resultCard.getBoundingClientRect();

                const x =
                    (event.clientX - rect.left) / rect.width;

                const y =
                    (event.clientY - rect.top) / rect.height;

                const rotateY = (x - .5) * 8;
                const rotateX = (y - .5) * -8;

                resultCard.style.setProperty(
                    "--mx",
                    (x * 100) + "%"
                );

                resultCard.style.setProperty(
                    "--my",
                    (y * 100) + "%"
                );

                resultCard.style.transform = `
                    perspective(900px)
                    rotateX(${rotateX}deg)
                    rotateY(${rotateY}deg)
                    translateZ(8px)
                `;
            });

            resultCard.addEventListener("mouseleave", function () {
                resultCard.style.transform = "";
            });

            const orb =
                document.getElementById("heroOrb");

            orb.addEventListener("mousemove", function (event) {
                const rect =
                    orb.getBoundingClientRect();

                const x =
                    (event.clientX - rect.left) / rect.width - .5;

                const y =
                    (event.clientY - rect.top) / rect.height - .5;

                const icon =
                    orb.querySelector(".orb-icon");

                icon.style.transform = `
                    translateY(${-y * 12}px)
                    rotateY(${x * 40 + 180}deg)
                    rotateX(${-y * 25}deg)
                `;
            });

            orb.addEventListener("mouseleave", function () {
                const icon =
                    orb.querySelector(".orb-icon");

                icon.style.transform = "";
            });
        }

        function initParticles() {
            const canvas =
                document.getElementById("spaceCanvas");

            const ctx = canvas.getContext("2d");
            const particles = [];
            const count = 90;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function createParticle() {
                return {
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    size: Math.random() * 1.7 + .3,
                    speed: Math.random() * .25 + .05,
                    alpha: Math.random() * .6 + .1,
                    color: Math.random() > .5
                        ? "#00f0ff"
                        : "#9d00ff"
                };
            }

            function reset() {
                particles.length = 0;

                for (let i = 0; i < count; i++) {
                    particles.push(createParticle());
                }
            }

            function animate() {
                ctx.clearRect(
                    0,
                    0,
                    canvas.width,
                    canvas.height
                );

                particles.forEach(function (particle) {
                    particle.y -= particle.speed;

                    if (particle.y < -10) {
                        particle.y = canvas.height + 10;
                        particle.x = Math.random() * canvas.width;
                    }

                    ctx.globalAlpha = particle.alpha;
                    ctx.fillStyle = particle.color;
                    ctx.beginPath();
                    ctx.arc(
                        particle.x,
                        particle.y,
                        particle.size,
                        0,
                        Math.PI * 2
                    );
                    ctx.fill();
                });

                ctx.globalAlpha = 1;
                requestAnimationFrame(animate);
            }

            resize();
            reset();
            animate();

            window.addEventListener("resize", function () {
                resize();
                reset();
            });
        }

        function getMaxRepeat(value) {
            if (!value.length) {
                return 0;
            }

            let max = 1;
            let current = 1;

            for (let i = 1; i < value.length; i++) {
                if (value[i] === value[i - 1]) {
                    current++;
                    max = Math.max(max, current);
                } else {
                    current = 1;
                }
            }

            return max;
        }

        function getSequenceLength(value) {
            const sequences = [
                "0123456789",
                "1234567890",
                "9876543210",
                "0987654321"
            ];

            let longest = 0;

            sequences.forEach(function (sequence) {
                for (let length = 10; length >= 4; length--) {
                    if (
                        value.includes(
                            sequence.slice(0, length)
                        )
                    ) {
                        longest = Math.max(longest, length);
                        break;
                    }
                }
            });

            return longest;
        }

        function loadHistory() {
            try {
                const saved = JSON.parse(
                    localStorage.getItem("numberHistory") || "[]"
                );

                return Array.isArray(saved) ? saved : [];
            } catch {
                return [];
            }
        }

        function saveHistory() {
            try {
                localStorage.setItem(
                    "numberHistory",
                    JSON.stringify(history)
                );
            } catch {
                console.warn("Историю не удалось сохранить");
            }
        }

        function formatPhone(digits) {
            return (
                "+7 (" +
                digits.slice(0, 3) +
                ") " +
                digits.slice(3, 6) +
                "-" +
                digits.slice(6, 8) +
                "-" +
                digits.slice(8, 10)
            );
        }

        function formatMoney(value) {
            return Math.round(Number(value) || 0)
                .toLocaleString("ru-RU") + " ₽";
        }

        function reverseString(value) {
            return value.split("").reverse().join("");
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
