{
  "expo": {
    "name": "NEXO",
    "slug": "nexo-messenger",
    "version": "1.0.0",
    "scheme": "nexo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexo.messenger",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": true
      }
    },
    "android": {
      "package": "com.nexo.messenger",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B12"
      },
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0B0B12"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
